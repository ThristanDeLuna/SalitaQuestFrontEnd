# Copy to .env.local (never commit it). Anything starting with VITE_ is public and baked into the build.
# Local API: http://localhost:3000   Live API: your Render URL
VITE_API_BASE_URL=
# Google OAuth client ID (public, no secret in this flow)
VITE_GOOGLE_CLIENT_ID=
# Public link of the Google Form used for "Report a problem" and "Request Contributor access" (DEC-63)
VITE_FEEDBACK_FORM_URL=
